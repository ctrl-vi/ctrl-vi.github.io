---
import { Image } from "astro:assets";

import "./Card.css";

interface Props {
    link: string;
    title: string;
    startDate: Date;
    finishDate?: Date;
    image: ImageMetadata;
    alt: string;
    description: string;
    icons: string[];
}

const { link, title, startDate, finishDate, image, alt, description, icons } =
    Astro.props;

const iconModules = import.meta.glob<ImageMetadata>("@cardIcons/*", {
    eager: true,
    import: "default",
});
const iconMap = new Map<string, ImageMetadata>();

for (const [path, image] of Object.entries(iconModules)) {
    const filename = path.split("/").pop() ?? "";
    const iconName = filename.replace(/\.[^.]+$/, "");
    iconMap.set(iconName, image);
}

const javascriptIcon = iconMap.get("js");
if (javascriptIcon) {
    iconMap.set("jsx", javascriptIcon);
}
const cppIcon = iconMap.get("cpp");
if (cppIcon) {
    iconMap.set("c++", cppIcon);
}

function formatDate(date?: Date) {
    if (date == null) {
        return "current";
    }
    return date.getUTCMonth() + 1 + "/" + date.getUTCFullYear();
}

const dateString = formatDate(startDate) + " - " + formatDate(finishDate);
---

<a href={link} class="card-link">
    <div class="card">
        <Image class="card-image" src={image} alt={alt} loading="eager" />
        <h2 class="card-header"><b>{title}</b></h2>
        <p class="card-date">{dateString}</p>

        <div class="card-icon-container">
            {
                icons.map((icon: string) => (
                    <Image
                        src={iconMap.get(icon) ?? iconMap.get("blank")!}
                        alt={`${icon}'s icon`}
                        loading="lazy"
                        inferSize={true}
                    />
                ))
            }
        </div>
        <p class="card-text">{description}</p>
    </div>
</a>
